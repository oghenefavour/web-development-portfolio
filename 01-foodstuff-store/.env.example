# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foodstuff_store
# Cloud MySQL (e.g. Aiven): set DB_SSL=true. Optionally paste the CA certificate into DB_SSL_CA.
DB_SSL=false
# DB_SSL_CA=

# Protects admin endpoints (product management, order status). Use a long random string.
ADMIN_API_KEY=change-me-to-a-long-random-string

# true = create the tables and sample data automatically on first start (handy for hosting)
AUTO_INIT_DB=true

# Optional business settings (values in kobo; 100 kobo = NGN 1)
# DELIVERY_FEE_KOBO=250000
# FREE_DELIVERY_THRESHOLD_KOBO=10000000
