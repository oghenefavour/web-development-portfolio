# Copy to .env and fill in. Never commit .env.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=urgent2k

# Cloud MySQL (e.g. Aiven): set DB_SSL=true. Optionally paste the CA certificate into DB_SSL_CA.
DB_SSL=false
# DB_SSL_CA=

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# true = create the tables and demo data automatically on first start (handy for hosting)
AUTO_INIT_DB=true
